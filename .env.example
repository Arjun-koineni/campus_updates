NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_updates?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_TTL_HOURS=24
COOKIE_NAME=campus_session
ADMIN_ROLL_NO=ADMIN001
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=change-me-to-a-long-password
APP_TIMEZONE=Asia/Kolkata
EXPIRY_GRACE_HOURS=2.5
MOCK_EMAIL=true
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=campus@example.edu
EMAIL_FROM_NAME=Campus Updates
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=campus-updates
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
